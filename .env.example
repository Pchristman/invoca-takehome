# Optional. AI takeaways are on exactly when this is set. Leave empty to run without AI.
ANTHROPIC_API_KEY=
# Spend guard for the running app, in US dollars. The app stops calling the model past this.
AI_SPEND_LIMIT_USD=5
# Folder holding calls.csv, campaigns.csv and locations.csv. Empty means the repo root.
DATA_DIR=
# Port the server listens on.
PORT=3000
# Address the server listens on. Leave it alone on your own machine; the Docker image sets 0.0.0.0 inside the container and Compose publishes only on your 127.0.0.1.
HOST=127.0.0.1
# AI call log (one line per call): logs/ai-calls.jsonl. Takeaway cache: .cache/ai-takeaways.json. Both are gitignored.
