# Optional. AI takeaways are on exactly when this is set. Leave empty to run without AI.
ANTHROPIC_API_KEY=
# Spend guard for the running app, in US dollars. The app stops calling the model past this.
AI_SPEND_LIMIT_USD=5
# Folder holding calls.csv, campaigns.csv and locations.csv. Empty means the repo root.
DATA_DIR=
# Port the server listens on.
PORT=3000
